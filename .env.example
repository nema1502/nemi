# Meta Model API key (https://dev.meta.ai)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Optional: which Meta model does which job
NEMI_PLANNER_MODEL=muse-spark-1.3
NEMI_CODER_MODEL=muse-spark-1.3
NEMI_VISION_MODEL=muse-spark-1.3

# Engine URL as seen by the renderer, and allowed web origins
NEMI_PUBLIC_URL=http://localhost:8000
NEMI_CORS_ORIGINS=http://localhost:3000
